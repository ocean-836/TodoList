{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daylog",
  "version": "0.1.0",
  "identifier": "com.daylog.desktop",
  "build": {
    "frontendDist": "../../daylog-prototype"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "日子 Daylog",
        "width": 1120,
        "height": 760,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
